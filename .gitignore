# Datos con informacion personal real de colaboradores - nunca subir a git
*.xlsx
~$*.xlsx
# Excepcion: SHIFT.xlsx se versiona SOLO como template (encabezados, sin datos).
# ⚠️ NUNCA commitear SHIFT.xlsx con filas de personas reales.
!SHIFT.xlsx

# Capturas de depuracion (pueden mostrar datos de pantalla)
debug_*.png

# Carpetas y archivos de documentos reales de colaboradores - nunca a git
Ingresos*/
Docs/
Docs_*/
*.pdf
*.PDF

# Python
__pycache__/
*.pyc

# Artefactos de PyInstaller (generados por construir_exe.bat) - el .exe pesa
# ~100 MB, no tiene sentido versionarlo. El .spec SI se versiona.
build/
dist/

# Capturas del panel de carga en modo prueba: muestran RUT y documentos reales.
capturas/

# Configuracion local de Claude Code (especifica de esta maquina)
.claude/*
# Las reglas de carga diferida para Claude Code sí se versionan
!.claude/rules/
